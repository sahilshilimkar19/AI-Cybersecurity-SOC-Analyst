# ---------------------------------------------------------------------------
# AI Cybersecurity SOC Analyst — .gitignore
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
develop-eggs/
.installed.cfg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# --- Node / Frontend (used from the Frontend sprint onward) ---
node_modules/
frontend/dist/
frontend/build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & secrets (NEVER commit real secrets) ---
.env
.env.*
!.env.example
*.local

# --- Runtime logs & data ---
logs/*
!logs/.gitkeep
*.log

# --- Local infrastructure / data volumes ---
.data/
data/

# --- IDE / editor / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
