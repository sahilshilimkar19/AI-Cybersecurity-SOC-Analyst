# ---------------------------------------------------------------------------
# AI Cybersecurity SOC Analyst — environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust for your local environment:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER contain real secrets committed to the
# repository. All variables are read by config/settings.py and are prefixed
# with `SOC_`. Additional variables are introduced by the sprint that first
# needs them (e.g. database and cache URLs in later sprints).
# ---------------------------------------------------------------------------

# Human-readable application name.
SOC_APP_NAME=AI Cybersecurity SOC Analyst

# Deployment environment: local | development | staging | production
SOC_ENVIRONMENT=local

# Debug mode. MUST be false in production (enforced by settings validation).
SOC_DEBUG=true

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
SOC_LOG_LEVEL=DEBUG

# Emit structured JSON logs (true) or human-readable console logs (false).
# Recommended: false locally, true in staging/production.
SOC_LOG_JSON=false

# --- Database (Sprint 2) ----------------------------------------------------
# SQLAlchemy URL. The default below targets the local docker-compose PostgreSQL.
# In staging/production this is supplied from the secret store, NEVER committed.
SOC_DATABASE_URL=postgresql+psycopg://soc:soc_local_pw@localhost:5432/soc_analyst
SOC_DATABASE_ECHO=false
SOC_DATABASE_POOL_SIZE=5

# --- Object storage for raw evidence (Sprint 2) -----------------------------
# S3-compatible object store (local docker-compose MinIO defaults shown).
SOC_OBJECT_STORE_ENDPOINT=localhost:9000
SOC_OBJECT_STORE_ACCESS_KEY=soc_minio
SOC_OBJECT_STORE_SECRET_KEY=soc_minio_local_pw
SOC_OBJECT_STORE_BUCKET=soc-evidence
SOC_OBJECT_STORE_SECURE=false

# --- OIDC (Sprint 3) --------------------------------------------------------
# The platform is an OIDC Relying Party; identity is federated to an external IdP.
# The client secret is supplied from the secret store in real environments.
SOC_OIDC_ISSUER=
SOC_OIDC_CLIENT_ID=
SOC_OIDC_CLIENT_SECRET=
SOC_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
SOC_OIDC_SCOPES=openid profile email
SOC_OIDC_AUDIENCE=
SOC_OIDC_ROLE_CLAIM=roles
SOC_OIDC_DEFAULT_ROLE=analyst

# --- Session tokens (Sprint 3) ----------------------------------------------
# The RP issues its own short-lived access JWT + rotating refresh token.
# SOC_JWT_SECRET MUST be overridden with a strong value outside local dev.
SOC_JWT_SECRET=dev-insecure-change-me
SOC_JWT_ALGORITHM=HS256
SOC_JWT_ISSUER=soc-analyst
SOC_ACCESS_TOKEN_TTL_SECONDS=900
SOC_REFRESH_TOKEN_TTL_SECONDS=604800

# --- Sessions & rate limiting (Sprint 3) ------------------------------------
SOC_SESSION_BACKEND=memory
SOC_REDIS_URL=redis://localhost:6379/0
SOC_RATE_LIMIT_REQUESTS=100
SOC_RATE_LIMIT_WINDOW_SECONDS=60
